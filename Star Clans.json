      {
        "type": "upgrade",
        "import": true,
        "name": "Specialized Clan Unit",
        "hidden": false,
        "id": "32bc-92d7-496b-b4c7",
        "selectionEntryGroups": [
          {
            "name": "Regolithian Nomads",
            "id": "e077-bb7d-9768-1361",
            "hidden": false,
            "profiles": [
              {
                "name": "Regolithian Nomads",
                "typeId": "0d83-d584-6c16-6b6f",
                "typeName": "Lore",
                "hidden": false,
                "id": "d57c-66e4-a11e-aed1",
                "characteristics": [
                  {
                    "name": "Lore",
                    "typeId": "8f51-2099-f67c-300e",
                    "$text": "Regolithian Nomads are named after the formation of warriors from history long ago and their ancient lifestyle. The Planet Regol-their Clan World- was once teeming with Warlords and unproper \n\n\nRegolithian Nomads are always the 1st squad of Mechanized veterans assembled in a formation. They carry the names of the tribals of their Clan-World Regol.\n\n\nTo be a part of a Regolithian Nomad unit is a great honor, as the history of the Nomads date far back before the creation of the clan itself. It is said these warriors were veterans of many events across the planet and died as they lived"
                  }
                ]
              }
            ]
          }
        ]
      }
