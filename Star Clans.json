          }
        ],
        "selectionEntryGroups": [
          {
            "name": "Star Clan Officer",
            "id": "137e-ed14-457c-8a00",
            "hidden": false,
            "selectionEntries": [
              {
                "type": "upgrade",
                "import": true,
                "name": "Clan Khogal Officer",
                "hidden": false,
                "id": "7a21-8e2c-c1c5-77b9",
                "profiles": [
                  {
                    "name": "Khogal Officer",
                    "typeId": "0d83-d584-6c16-6b6f",
                    "typeName": "Lore",
                    "hidden": false,
                    "id": "0c64-1f1c-83b8-28a0",
                    "characteristics": [
                      {
                        "name": "Lore",
                        "typeId": "8f51-2099-f67c-300e",
                        "$text": "Khogal Officers on Regol, like many clans, earn their title via trials; Proving of Khogal. An officer must brave the elements of Regol from a drop-off point and travel on-foot to the Clan World's Capital of Zovkhayen. They will encounter many hardships as the original colonists and nomads of Regol once did, remembering their past and the qualities that make them what they are."
                      }
                    ]
                  }
                ],
                "modifiers": [
                  {
                    "type": "set",
                    "value": true,
                    "field": "hidden",
                    "conditions": [
                      {
                        "type": "lessThan",
                        "value": 1,
                        "field": "selections",
                        "scope": "roster",
                        "childId": "86b9-87dc-3f7d-b930",
                        "shared": true,
                        "includeChildSelections": true,
                        "includeChildForces": true,
                        "childName": "Star Clan Khogal"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "upgrade",
                "import": true,
                "name": "Star Clan Officer",
                "hidden": false,
                "id": "2388-3c85-2b5f-b07e",
                "modifiers": [
                  {
                    "type": "set",
                    "value": true,
                    "field": "hidden",
                    "conditions": [
                      {
                        "type": "lessThan",
                        "value": 1,
                        "field": "selections",
                        "scope": "roster",
                        "childId": "1031-81b1-11ed-83d2",
                        "shared": true,
                        "includeChildSelections": true,
                        "includeChildForces": true,
                        "childName": "Generic Star Clan"
                      }
                    ]
                  }
                ],
                "profiles": [
                  {
                    "name": "Clan Officer",
                    "typeId": "0d83-d584-6c16-6b6f",
                    "typeName": "Lore",
                    "hidden": false,
                    "id": "5c56-d62a-d935-6d32",
                    "characteristics": [
                      {
                        "name": "Lore",
                        "typeId": "8f51-2099-f67c-300e",
                        "$text": "The title of Officer in Star Clans is a faux-title as instead of the traditional meaning of the rank, it is instead to denote one who earned it by respect through a variety of means: Winning against unfavorable odds, promise shown in training, displaying the traits of \"true brethren of the clan\" and many more."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "upgrade",
                "import": true,
                "name": "Clan Kilroy's \"Tophat\" (Officer)",
                "hidden": false,
                "id": "1995-3199-6c7b-a710",
                "profiles": [
                  {
                    "name": "Kilroy's \"Tophat\" (Officer)",
                    "typeId": "0d83-d584-6c16-6b6f",
                    "typeName": "Lore",
                    "hidden": false,
                    "id": "6b16-0d04-a2a8-773b",
                    "characteristics": [
                      {
                        "name": "Lore",
                        "typeId": "8f51-2099-f67c-300e",
                        "$text": "Those under Lady Kilroy's control on Kilroy's Paradise are not seen in any rank whatsoever, either simple gangers or those of note, however due to the societal norms set up by the Star Clans, the most brash or most confident are put in control to be officers, joked to be Top-Hats; due to their stolen caps and medals. There is little fanfare, honors and awards for a Top-Hat, as the real reward is the brawl, either with allies or their enemies; a philosophy beloved by the Star clans."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "upgrade",
                "import": true,
                "name": "Clan Wolf Officer",
                "hidden": false,
                "id": "8ebb-a0d0-9faa-7962",
                "profiles": [
                  {
                    "name": "Clan Wolf Officer",
                    "typeId": "0d83-d584-6c16-6b6f",
                    "typeName": "Lore",
                    "hidden": false,
                    "id": "9c3f-76dc-e38d-c367",
                    "characteristics": [
                      {
                        "name": "Lore",
                        "typeId": "8f51-2099-f67c-300e",
                        "$text": "The Clan's officers are crass, brutally honest, and experienced to the letter, as Clan Wolf's officers lead the training drills no matter their rank or position, their service and advice is unmatched when advising a force. The Valerius Alliance would employ their services after the Star-Clan Pact was signed to better train their own regiments. Clan Wolf Officers train their minds around the clock, preparing themselves for any scenario for themselves or their force.\n"
                      }
                    ]
                  }
                ]
              }
            ],
