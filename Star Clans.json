            "id": "ecd3-0176-10b7-5380",
            "hidden": false,
            "selectionEntries": [
              {
                "type": "upgrade",
                "import": true,
                "name": "Clan Kilroy",
                "hidden": false,
                "id": "6513-835b-cc41-21d7",
                "profiles": [
                  {
                    "name": "Alliance Clan Kilroy",
                    "typeId": "0d83-d584-6c16-6b6f",
                    "typeName": "Lore",
                    "hidden": false,
                    "id": "c57f-a40c-7a51-42e2",
                    "characteristics": [
                      {
                        "name": "Lore",
                        "typeId": "8f51-2099-f67c-300e",
                        "$text": "Clan Kilroy has it's history rooted in the criminal undergrounds of the Valerius system with indomitable control over the market of Walkers and Mechanicals, it was until the days of the full reconstruction of Valerius Prime where they fought against the fledgling Alliance Regiments. However, due to the sheer number of them underneath Lady Kilroy's control, the Alliance requested a place to allocate them; and the Star Clans answered. Kilroy and her underlings were given a Clan World to carve and make their own, earning their keep by both the Star Clans and the Alliance alike whilst keeping their \"individuality\" and \"Unique\" culture."
                      }
                    ]
                  }
                ],
                "rules": [
                  {
                    "name": "Tactics of Clan Kilroy",
                    "id": "a344-3330-17c9-509d",
                    "hidden": false,
                    "description": "When a STAR CLAN KILROY Infantry Unit fights in Melee Combat, they may \n\n\nWhen a STAR CLAN KILROY Mec\n---ALLIANCE REGIMENT ALLIES--\nThis army organization chart may be the allied organization chart to a Alliance Regiment Organization Chart, however, All CLAN KILROY Units gain the Distrusted Allies Special Rule."
                  }
                ]
              },
              {
                "type": "upgrade",
                "import": true,
                "name": "Generic Star Clan",
                "hidden": false,
                "id": "1031-81b1-11ed-83d2",
                "rules": [
                  {
                    "name": "Star Clans",
                    "id": "d0b4-e538-380f-bf18",
                    "hidden": false,
                    "description": "Star Clans being pockets of Human Colonist separated from the original source of Humans in the Universe; the Valerius Alliance. \n\n\nEarning the title Star Clans due to their numbers and separation from Humanity, they possessed advanced technologies and societal structure due to their lower population count and initial isolation upon their Clan Worlds; Planets the sizes of dwarves or Moons solely inhabited by them and wildlife. Due to their advanced technology and isolation, these Star Clans would practice warfare against their own planets in controlled environments or even against each other, simulating small or grand scale warfare; making them unmatched in combat either on foot or inside their personal mechanizations."
                  }
                ]
              },
              {
                "type": "upgrade",
                "import": true,
                "name": "Star Clan Khogal",
                "hidden": false,
                "id": "86b9-87dc-3f7d-b930",
                "profiles": [
                  {
                    "name": "Star Clan Khogal",
                    "typeId": "0d83-d584-6c16-6b6f",
                    "typeName": "Lore",
                    "hidden": false,
                    "id": "1a64-3de8-0dd9-d2e2",
                    "characteristics": [
                      {
                        "name": "Lore",
                        "typeId": "8f51-2099-f67c-300e",
                        "$text": "Clan Khogal's thirst for war-games and extreme conditioning began from the very beginning, thought to be one of the very first Clans to be made, as they were routed in harsh conditions and mechanized warfare, which was made up of Colonists that had divided themselves into their own tribes upon the Clan-world. Clan Khogal is noted for their near-psychopathic joy in combat(Even more than other Star Clans) and the ability to weather whatever environment they fight in."
                      }
                    ]
                  }
                ],
                "rules": [
                  {
                    "name": "Tactics of Clan Khogal",
                    "id": "f409-6001-f553-dc4b",
                    "hidden": false
                  }
                ]
              },
              {
                "type": "upgrade",
                "import": true,
                "name": "Star Clan Wolf",
                "hidden": false,
                "id": "bc32-af6c-f0b2-7998",
                "profiles": [
                  {
                    "name": "Star Clan Wolf",
                    "typeId": "0d83-d584-6c16-6b6f",
                    "typeName": "Lore",
                    "hidden": false,
                    "id": "f374-34bc-8845-a5af",
                    "characteristics": [
                      {
                        "name": "Lore",
                        "typeId": "8f51-2099-f67c-300e",
                        "$text": "Clan Wolf was the first Clan to join the Valerius Alliance and stood alongside it during it's fledgling years. Clan Wolf contributes officers of it's clan to the Alliance Regiments to guide training, many of these officers are given the highest respects as their training is a step-above most others. Clan Wolf's greatest and most decisive action was their full trust of the Pioneers, as unlike other Clans, they welcomed them with open arms; even refusing to teach Regiments that refused adoption or proper care of the Pioneers. However the ever-defiant Clan has ignored the pleas and bribes of many, and those Regiments that are taught alongside the Pioneers now see greater success than ever before."
                      }
                    ]
                  }
                ],
                "rules": [
                  {
                    "name": "Tactics of Clan Wolf",
                    "id": "eeab-5a19-345c-9ef5",
                    "hidden": false,
                    "description": "All STAR CLAN Models in this Army Organization Chart gain +1 to their Discipline and Willpower. Anytime a Model/Unit is forced to take a Fall Back Movement, instead they take a Discipline Test and if they succeed, they ignore it.\n\n---ALLIANCE REGIMENT ALLIES--\nThis army organization chart may be the allied organization chart to a Alliance Regiment Organization Chart, any PIONEER Units in that Alliance Regiment chart ignore the Distrusted Ally Special Rule for Star Clan Headquarters Unit.\n---PIONEER COMPANY ALLIES--\nPioneer Company army organization chart may be the allied organization chart to a Star Clan Wolf Army Organization Chart, all PIONEER Units in that Pioneer Company chart ignore the Distrusted Ally Special Rule and gain benefit to the Tactics of Clan Wolf Special Rule."
                  }
                ]
              }
            ],
            "constraints": [
