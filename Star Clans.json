        "selectionEntryGroups": [
          {
            "name": "Regolithian El-Ghuls",
            "id": "1acf-0ee9-2d9a-2e91",
            "hidden": false,
            "profiles": [
              {
                "name": "Regolithian El-Ghuls",
                "typeId": "0d83-d584-6c16-6b6f",
                "typeName": "Lore",
                "hidden": false,
                "id": "6d22-c43c-c1c7-ee0f",
                "characteristics": [
                  {
                    "name": "Lore",
                    "typeId": "8f51-2099-f67c-300e",
                    "$text": "The Regolithian El-Ghuls or \"Sand Ghouls\" or \"Sand Devils\" are veterans of Clan Khogal that have become too engulfed into warfare and their surrounding environments. These Elite Clanners "
                  }
                ]
              }
            ]
          },
          {
            "name": "Star Clan Grenadiers",
            "id": "f875-c36b-1c16-c2d7",
            "hidden": false,
            "profiles": [
              {
                "name": "Star Clan Grenadiers",
                "typeId": "0d83-d584-6c16-6b6f",
                "typeName": "Lore",
                "hidden": false,
                "id": "4c44-ad8f-375a-2956",
                "characteristics": [
                  {
                    "name": "Lore",
                    "typeId": "8f51-2099-f67c-300e",
                    "$text": "Star Clan Grenadiers are the equivalent of a Veteran Infantry unit of the Alliance Regiments. Decorated, skilled, and most of all, consistent, these Grenadiers exemplify their Clan's doctrine and traits."
                  }
                ]
              }
            ]
          },
          {
            "name": "Kilroy's Jackhammers",
            "id": "a8d3-70bd-8830-aa00",
            "hidden": false,
            "rules": [
              {
                "name": "Kilroy's Jackhammers",
                "id": "ea6e-7144-ec2a-c69e",
                "hidden": false,
                "description": "The Jackhammers of Clan Kilroy earn their namesake by their custom weaponry that are not only heavily modified, but also have been seen and noted in reports by other forces. These custom weapons were once advanced energy weaponry, taken or earned in combat against other Clans, and converted until unwieldly monstrosities that fire projectiles of both energy and lead. Despite earning the name by wielding the weapons and being veterans of the Clan,  \"Jack Hammer\" is named after the weapon itself, due to it's insanely loud noise and moving parts."
              }
            ]
          },
          {
            "name": "Forillaen Veterans",
            "id": "6aaf-897c-25f1-e83b",
            "hidden": false,
            "rules": [
              {
                "name": "Forillaen Veterans",
                "id": "d10e-b5d2-4318-81e4",
                "hidden": false,
                "description": "Forillaen Veterans of Clan Wolf are those who've refused the rank of Officer, wishing to fight on the ground alongside their fellow Infantrymen. They keep the order of troops when Officers cannot, and offer aid to take down difficult targets."
              }
            ]
          }
        ]
      },
