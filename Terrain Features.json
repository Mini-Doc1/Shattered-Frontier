        "profiles": [
          {
            "name": "Flashing Dodger ",
            "typeId": "a43d-8b65-0808-c7b2",
            "typeName": "Anomalies",
            "hidden": false,
            "id": "9b82-8aa9-cece-b168",
            "characteristics": [
              {
                "name": "Description",
                "typeId": "ec4f-7524-af44-7bce",
                "$text": "At the start of each round, roll 3d6 and a scatter dice for the direction and the amount of inches that the Flashing Dodger. Any unit that ends within 6 inches of a Flashing Dodger must take an Initiative Test. If they fail, they perform a movement action towards the Flashing Dodger; even if they have no actions left. If there is any models within 6 inches of the Flashing Dodger at the start of the round, each model is dealt 1 damage; which cannot be saved."
              }
            ]
          }
        ]
